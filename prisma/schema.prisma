generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  tickets    Ticket[]
  slaPolicies SLAPolicy[]
  holidays   Holiday[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  password  String
  name      String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets         Ticket[] @relation("CustomerTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  comments        Comment[]

  @@index([tenantId])
}

model Ticket {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  number          Int
  displayId       String
  title           String
  description     String
  status          String
  priority        String
  category        String?
  customerId      String
  customer        User      @relation("CustomerTickets", fields: [customerId], references: [id])
  assignedToId    String?
  assignedTo      User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  firstResponseAt     DateTime?
  firstResponseSlaDue DateTime?
  resolvedAt          DateTime?
  firstClosedAt       DateTime?
  closedAt            DateTime?
  lastReopenedAt      DateTime?
  reopenCount         Int        @default(0)
  pendingUntil        DateTime?
  pendingReason       String?
  lastActivityAt      DateTime   @default(now())
  followUpOfId        String?
  followUpOf          Ticket?    @relation("TicketFollowUps", fields: [followUpOfId], references: [id])
  followUps           Ticket[]   @relation("TicketFollowUps")
  slaDueAt            DateTime?
  slaBreached         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  comments Comment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assignedToId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, pendingUntil])
  @@index([followUpOfId])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  type      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([ticketId, type])
}

model SLAPolicy {
  id              String  @id @default(cuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  priority        String
  firstResponseH  Int
  resolutionH     Int
  resolutionIsBD  Boolean @default(false)

  @@unique([tenantId, priority])
  @@index([tenantId])
}

model InboundMessage {
  id        String   @id @default(cuid())
  tenantId  String?
  messageId String   @unique
  fromEmail String
  subject   String?
  body      String
  raw       String
  status    String
  ticketId  String?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([status])
}

model TicketCounter {
  tenantId   String @id
  lastNumber Int
}

model Holiday {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  date     DateTime
  name     String?

  @@unique([tenantId, date])
  @@index([tenantId, date])
}
