{
  "name": "ticketbase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "dev:mock": "tsx watch src/mock-mail-channel/index.ts",
    "start:e2e:backend": "tsx src/backend/index.ts",
    "start:e2e:frontend": "vite --config src/frontend/vite.config.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:mock\"",
    "build:backend": "tsc -p tsconfig.json",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "build": "npm run build:backend && npm run typecheck:frontend && npm run build:frontend",
    "lint": "eslint src/",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run --config vitest.config.ts",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:e2e": "tsx src/tests/e2e/prepare.ts && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "perf": "tsx src/tests/perf.ts",
    "race-test": "tsx src/tests/race-test.ts",
    "isolation-test": "tsx src/tests/isolation-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "7.18.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
